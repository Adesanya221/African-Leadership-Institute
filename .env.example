# Lemon Squeezy API Keys
# See LEMONSQUEEZY_SETUP_GUIDE.md for step-by-step instructions
LEMONSQUEEZY_API_KEY=your_api_key_here
LEMONSQUEEZY_STORE_ID=your_store_id_here
LEMONSQUEEZY_VARIANT_ID=your_variant_id_here

# Supabase (Database for registration data)
# Get these from https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Site URL (used for meta tags & payment redirects)
# Update this after deploying to Vercel
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
