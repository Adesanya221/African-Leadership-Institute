# ── PayPal Payment ───────────────────────────────────────────────────────────
# Your PayPal payment link (PayPal.Me or Standard button URL).
# Example: https://www.paypal.com/paypalme/africanleadership/50USD
PAYPAL_PAYMENT_URL=your_paypal_payment_link_here

# ── Supabase (Database for registration data) ───────────────────────────────
# Get these from https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role Key (server-side only, keeps RLS bypass secret).
# Get from Supabase → Project Settings → API → Service Role Key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Site URL ────────────────────────────────────────────────────────────────
# Used for meta tags & payment redirect URLs
NEXT_PUBLIC_SITE_URL=https://african-leadership-institute.vercel.app/

# ── Lemon Squeezy (commented out – kept for reference) ─────────────────────
# LEMONSQUEEZY_API_KEY=your_api_key_here
# LEMONSQUEEZY_STORE_ID=your_store_id_here
# LEMONSQUEEZY_VARIANT_ID=your_variant_id_here
